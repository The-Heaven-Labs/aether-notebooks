  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^4.4.0",
    "@hocuspocus/server": "^4.4.0",
    "ioredis": "~5.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
