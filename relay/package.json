{
  "name": "aether-relay",
  "version": "1.0.0",
  "description": "Hocuspocus Yjs relay for Aether Notebooks",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
