{
  "realm": "aether-dev",
  "enabled": true,
  "sslRequired": "none",

  "clients": [
    {
      "clientId": "aether-dev",
      "enabled": true,
      "publicClient": false,
      "secret": "aether-dev-keycloak-secret",
      "redirectUris": [
        "http://localhost:8080/api/v1/auth/oidc/*"
      ],
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "full.path": "false"
          }
        }
      ]
    }
  ],

  "groups": [
    {
      "name": "aether-analysts",
      "path": "/aether-analysts"
    },
    {
      "name": "aether-engineering",
      "path": "/aether-engineering"
    },
    {
      "name": "all-employees",
      "path": "/all-employees"
    }
  ],

  "users": [
    {
      "username": "alice",
      "email": "alice@aether-dev.test",
      "firstName": "Alice",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice123",
          "temporary": false
        }
      ],
      "groups": [
        "/aether-analysts",
        "/aether-engineering"
      ]
    },
    {
      "username": "bob",
      "email": "bob@aether-dev.test",
      "firstName": "Bob",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob123",
          "temporary": false
        }
      ],
      "groups": [
        "/aether-analysts",
        "/all-employees"
      ]
    }
  ]
}
